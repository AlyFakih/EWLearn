# Copy this file to backend/.env and fill in real values there.
# backend/.env is where the application actually reads these from
# (see backend/load_env.php) - this root copy exists purely as
# documentation of what's required, kept in sync with backend/.env.example.

# --- Database ---
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# --- SMTP (used by backend/send_email.php and backend/sendContactMessage.php) ---
SMTP_USERNAME=
SMTP_PASSWORD=
